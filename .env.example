# ── Backend ─────────────────────────────────────────────────────
APP_ID=                   # Application ID
APP_SECRET=               # Application secret (used for JWT signing)

# ── Public sharing ───────────────────────────────────────────────
# Optional override when the published game moves to another domain.
VITE_PUBLIC_URL=          # Example: https://your-game.ok.kimi.link

# ── Database ───────────────────────────────────────────────────
DATABASE_URL=             # MySQL connection string (mysql://user:pass@host:port/db)

# ── Optional shared password ───────────────────────────────────
# Leave empty for direct entry from the invite link.
ACCESS_PASSWORD=          # 16+ characters; browser login user is "player"
